APP_NAME="Buniyad API"
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# Postgres connection string — set this to your own local setup. If you
# installed Postgres via `brew install postgresql@16` and created a
# database with `createdb buniyad`, this is usually just your OS username
# with no password (Homebrew Postgres defaults to local trust auth):
DATABASE_URL=postgresql+psycopg://YOUR_OS_USERNAME@localhost:5432/buniyad

# Generate your own for any shared/deployed environment, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-only-secret-change-me-0123456789
